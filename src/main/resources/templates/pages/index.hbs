{{#partial "left"}}
    <mtg-search>
        <label for="search">Rechercher une carte : </label>
        <input id="search"
               type="text"
               name="q"
               placeholder="Liliana Vess"
               hx-get="/api/cards"
               hx-target="mtg-results-list"
               hx-trigger="input changed delay 1s"
        />
    </mtg-search>
    <mtg-results>
        <mtg-results-list>
            {{>parts/search-results}}
        </mtg-results-list>
    </mtg-results>
{{/partial}}

{{#partial "right"}}
    <mtg-result-details>

    </mtg-result-details>
{{/partial}}

{{>layout}}