extends ../application.jade

block main
    .ui.main.fluid.blue.secondary.inverted.vertical.segment
        form#form(
            hx-get="/api/cards",
            hx-target="#search-results",
            hx-trigger="submit"
            )
            .ui.fluid.inverted.transparent.left.icon.input
                input.prompt(
                    type=text,
                    name="q",
                    placeholder="ie: Liliana Vess",
                    hx-get="/api/cards",
                    hx-target="#search-results",
                    hx-trigger="input changed delay:1s"
                )#search
                i.search.icon

    .ui.three.column.padded.grid
        .ten.wide.column
            #search-results
        .six.wide.column
            #card